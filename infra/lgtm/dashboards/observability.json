        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"api-gateway|modular-app|eureka-server\"} | json",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "description": "Aggregated logs from every Java replica. Infrastructure is monitored through metrics."
    }
  ],
  "links": [
    {
      "title": "Search spans in Tempo Explore",
      "type": "link",
      "url": "/explore",
      "targetBlank": false
    }
  ]
