      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "App instances healthy",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ddd_service_replicas_healthy{service=\"modular-app\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{service}}",
          "instant": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Gateway structured JSON logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"api-gateway\"} | json",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      }
    },
    {
      "id": 5,
      "title": "Modular app structured logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"modular-app\"} | json",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      }
    },
    {
      "id": 7,
      "title": "HTTP API audit: method / URL / parameters / JSON bodies / status / duration",
      "description": "Backend servlet audit: JSON fields visible in log line details. Bodies logged for Catalog routes only; credentials are redacted; login/logout are excluded.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"modular-app\"} | json | event=\"http.audit\"",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": true
      }
    },
    {
      "id": 8,
      "title": "PostgreSQL connection (1=OK)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Redis connection (1=OK)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_up",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Service overview — replicas, health & startup",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service)(ddd_service_replicas_running)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by(service)(ddd_service_replicas_desired)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "sum by(service)(ddd_service_replicas_healthy)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "sum by(service)(ddd_service_restart_count)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "(sum by(service)(ddd_service_replicas_running) > bool 0) * ((sum by(service)(ddd_service_replicas_healthy) == bool sum by(service)(ddd_service_replicas_running)) + 2 * (sum by(service)(ddd_service_replicas_without_healthcheck) == bool sum by(service)(ddd_service_replicas_running)) + 3 * (sum by(service)(ddd_service_replicas_healthy) < bool sum by(service)(ddd_service_replicas_running)) * (sum by(service)(ddd_service_replicas_without_healthcheck) < bool sum by(service)(ddd_service_replicas_running)))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "1000 * max by(service)(ddd_container_started_at_seconds)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "align": "center",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Trạng thái health"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Đã dừng",
                        "color": "red"
                      },
                      "1": {
                        "text": "Healthy",
                        "color": "green"
                      },
                      "2": {
                        "text": "Chưa có healthcheck",
                        "color": "blue"
                      },
                      "3": {
                        "text": "Chờ / lỗi healthcheck",
                        "color": "orange"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Khởi động gần nhất"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "custom.width",
                "value": 210
              }
            ]
          }
        ]
      },
      "description": "Health status: healthy = all running replicas pass healthcheck; no healthcheck = containers are running but readiness is not verified; pending/unhealthy = at least one check is not healthy. Compare running with desired replicas. Auto restarts uses Docker RestartCount: manual restarts and container recreation are excluded. Last started shows the latest start among service replicas.",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "service",
            "mode": "outerTabular"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true
            },
            "indexByName": {
              "service": 0,
              "Value #E": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #F": 6
            },
            "renameByName": {
              "service": "Service",
              "Value #A": "Đang chạy",
              "Value #B": "Mong muốn",
              "Value #C": "Healthcheck OK",
              "Value #D": "Auto restarts",
              "Value #E": "Trạng thái health",
              "Value #F": "Khởi động gần nhất"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Service",
                "desc": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "Eureka structured JSON logs",
