      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Live application logs — click TraceID to open Tempo",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"api-gateway|modular-app|eureka-server\"}",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      }
    }
  ],
  "links": [
    {
      "title": "Explore traces in Tempo",
      "type": "link",
      "url": "/explore?left=%7B%22datasource%22%3A%22tempo%22%7D",
      "targetBlank": false
    },
    {
      "title": "Explore logs in Loki",
      "type": "link",
      "url": "/explore",
      "targetBlank": false
    }
  ]
}
