{
  "uid": "ddd-platform-ops",
  "title": "Operations — Replicas, Builds, Images & Logs",
  "tags": [
    "ddd",
    "deployment",
    "eureka",
    "docker"
  ],
  "description": "Live Docker state, immutable running image IDs and source-build lifecycle events. Old removed containers are retained in Loki operation history; Prometheus current-state metrics vanish after deletion.",
  "schemaVersion": 40,
  "version": 2,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Docker service",
        "type": "custom",
        "query": "modular-app,gateway,eureka,nginx,postgres,redis,postgres-backup,lgtm,ops-observer,alloy,postgres-exporter,redis-exporter,docker-socket-proxy",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Selected services — replicas, health & startup",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service)(ddd_service_replicas_running{service=~\"$service\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by(service)(ddd_service_replicas_desired{service=~\"$service\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "sum by(service)(ddd_service_replicas_healthy{service=~\"$service\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "sum by(service)(ddd_service_restart_count{service=~\"$service\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "(sum by(service)(ddd_service_replicas_running{service=~\"$service\"}) > bool 0) * ((sum by(service)(ddd_service_replicas_healthy{service=~\"$service\"}) == bool sum by(service)(ddd_service_replicas_running{service=~\"$service\"})) + 2 * (sum by(service)(ddd_service_replicas_without_healthcheck{service=~\"$service\"}) == bool sum by(service)(ddd_service_replicas_running{service=~\"$service\"})) + 3 * (sum by(service)(ddd_service_replicas_healthy{service=~\"$service\"}) < bool sum by(service)(ddd_service_replicas_running{service=~\"$service\"})) * (sum by(service)(ddd_service_replicas_without_healthcheck{service=~\"$service\"}) < bool sum by(service)(ddd_service_replicas_running{service=~\"$service\"})))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "1000 * max by(service)(ddd_container_started_at_seconds{service=~\"$service\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        },
        {
          "refId": "G",
          "expr": "max by(service)(ddd_watchdog_restarts{service=~\"$service\"})",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "H",
          "expr": "1000 * max by(service)(ddd_watchdog_last_attempt_seconds{service=~\"$service\"})",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "I",
          "expr": "max by(service)(ddd_watchdog_result{service=~\"$service\"})",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "enableHeaderWrap": true
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "align": "center",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Trạng thái health"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Đã dừng",
                        "color": "red"
                      },
                      "1": {
                        "text": "Healthy",
                        "color": "green"
                      },
                      "2": {
                        "text": "Chưa có healthcheck",
                        "color": "blue"
                      },
                      "3": {
                        "text": "Chờ / lỗi healthcheck",
                        "color": "orange"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Khởi động gần nhất"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "custom.width",
                "value": 210
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Watchdog gần nhất"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Chưa thử"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Kết quả phục hồi"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Chưa thử",
                        "color": "blue"
                      },
                      "1": {
                        "text": "Đã phục hồi",
                        "color": "green"
                      },
                      "2": {
                        "text": "Restart lỗi",
                        "color": "red"
                      },
                      "3": {
                        "text": "Quá hạn phục hồi",
                        "color": "red"
                      },
                      "4": {
                        "text": "Đang chờ health",
                        "color": "orange"
                      },
                      "5": {
                        "text": "Đã dừng",
                        "color": "blue"
                      },
                      "6": {
                        "text": "Container đã xóa",
                        "color": "blue"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "description": "Health status: healthy = all running replicas pass healthcheck; no healthcheck = containers are running but readiness is not verified; pending/unhealthy = at least one check is not healthy. Compare running with desired replicas. Auto restarts uses Docker RestartCount: manual restarts and container recreation are excluded. Last started shows the latest start among service replicas. Watchdog restarts persists successful restart commands across recreation; recovery result separately confirms readiness. Requires host watchdog heartbeat.",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "service",
            "mode": "outerTabular"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time 8": true
            },
            "indexByName": {
              "service": 0,
              "Value #E": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9
            },
            "renameByName": {
              "service": "Service",
              "Value #A": "Đang chạy",
              "Value #B": "Mong muốn",
              "Value #C": "Healthcheck OK",
              "Value #D": "Auto restarts",
              "Value #E": "Trạng thái health",
              "Value #F": "Khởi động gần nhất",
              "Value #G": "Watchdog restarts",
              "Value #H": "Watchdog gần nhất",
              "Value #I": "Kết quả phục hồi"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Service",
                "desc": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Image drift (mismatched containers)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ddd_container_image_drift == 0) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{service}}",
          "instant": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Observer Docker API status (1=OK)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ddd_observer_scrape_success",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{service}}",
          "instant": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Running gateway instances",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ddd_service_replicas_running{service=\"gateway\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{service}}",
          "instant": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Selected services: desired / running / healthy",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ddd_service_replicas_running{service=~\"$service\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{service}}",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "ddd_service_replicas_desired{service=~\"$service\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{service}}",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "ddd_service_replicas_healthy{service=~\"$service\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{service}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Docker auto restarts per selected container",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ddd_container_restart_count{service=~\"$service\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{service}} / {{container}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Docker RestartCount tracks automatic restarts, excluding manual restart and container recreation."
    },
    {
      "id": 10,
      "title": "Running image evidence — tags, image SHA, revisions, container IDs",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ddd_container_info{service=~\"$service\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Container health, current state and restart counts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ddd_container_restart_count{service=~\"$service\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Container created at (Unix seconds) / new container IDs",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ddd_container_created_at_seconds{service=~\"$service\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Live application logs — click TraceID to open Tempo",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"api-gateway|modular-app|eureka-server\"}",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      }
    },
    {
      "id": 99,
      "title": "Host watchdog (1=active, 0=offline)",
      "description": "Heartbeat younger than 90 seconds. Watchdog runs on host and only remediates persistently unhealthy running Java containers.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ddd_watchdog_up",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Watchdog offline",
                  "color": "red"
                },
                "1": {
                  "text": "Watchdog active",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "options": {
        "colorMode": "value"
      }
    }
  ],
  "links": [
    {
      "title": "Explore traces in Tempo",
      "type": "link",
      "url": "/explore?left=%7B%22datasource%22%3A%22tempo%22%7D",
      "targetBlank": false
    },
    {
      "title": "Explore logs in Loki",
      "type": "link",
      "url": "/explore",
      "targetBlank": false
    }
  ]
}
