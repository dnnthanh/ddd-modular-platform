\set ON_ERROR_STOP on

-- psql receives passwords from the environment. They never appear in the
-- command line or in this source file; format(... %L) quotes them as literals.
\getenv run_password DB_RUN_PASSWORD
\getenv backup_password DB_BACKUP_PASSWORD

SELECT format('CREATE ROLE %I LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD %L',
              'run', :'run_password')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'run')
\gexec
SELECT format('CREATE ROLE %I LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD %L',
              'backup', :'backup_password')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'backup')
\gexec

SELECT format('ALTER ROLE run WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD %L',
              :'run_password')
\gexec
SELECT format('ALTER ROLE backup WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD %L',
              :'backup_password')
\gexec

-- `modular` is the existing bootstrap/cluster-administration account.  It is
-- deliberately never exposed to application, backup, or observability services.
ALTER ROLE modular WITH LOGIN SUPERUSER CREATEDB CREATEROLE REPLICATION;

REVOKE ALL ON DATABASE modulardb FROM PUBLIC;
GRANT CONNECT ON DATABASE modulardb TO run, backup;

-- Existing installations made the public-schema application objects with
-- `modular`. Move only those objects to the run account; the database itself remains owned by
-- the cluster administrator.
SELECT format('ALTER %s %I.%I OWNER TO run',
              CASE c.relkind
                WHEN 'r' THEN 'TABLE'
                WHEN 'p' THEN 'TABLE'
                WHEN 'S' THEN 'SEQUENCE'
                WHEN 'v' THEN 'VIEW'
                WHEN 'm' THEN 'MATERIALIZED VIEW'
                WHEN 'f' THEN 'FOREIGN TABLE'
              END,
              n.nspname, c.relname)
FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
JOIN pg_roles owner ON owner.oid = c.relowner
WHERE n.nspname = 'public'
  AND owner.rolname = 'modular'
  AND c.relkind IN ('r', 'p', 'S', 'v', 'm', 'f')
\gexec
SELECT format('ALTER FUNCTION %I.%I(%s) OWNER TO run',
              n.nspname, p.proname, pg_get_function_identity_arguments(p.oid))
FROM pg_proc p
JOIN pg_namespace n ON n.oid = p.pronamespace
JOIN pg_roles owner ON owner.oid = p.proowner
WHERE n.nspname = 'public'
  AND owner.rolname = 'modular'
  AND p.prokind <> 'p'
\gexec
SELECT format('ALTER PROCEDURE %I.%I(%s) OWNER TO run',
              n.nspname, p.proname, pg_get_function_identity_arguments(p.oid))
FROM pg_proc p
JOIN pg_namespace n ON n.oid = p.pronamespace
JOIN pg_roles owner ON owner.oid = p.proowner
WHERE n.nspname = 'public'
  AND owner.rolname = 'modular'
  AND p.prokind = 'p'
\gexec
SELECT format('ALTER TYPE %I.%I OWNER TO run', n.nspname, t.typname)
FROM pg_type t
JOIN pg_namespace n ON n.oid = t.typnamespace
JOIN pg_roles owner ON owner.oid = t.typowner
WHERE n.nspname = 'public'
  AND owner.rolname = 'modular'
  AND t.typrelid = 0
  AND t.typtype IN ('b', 'c', 'd', 'e', 'm', 'r')
\gexec
ALTER SCHEMA public OWNER TO run;
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
GRANT USAGE ON SCHEMA public TO backup;

SELECT format('GRANT SELECT ON TABLE %I.%I TO backup',
              n.nspname, c.relname)
FROM pg_class c
JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE n.nspname = 'public'
  AND c.relkind IN ('r', 'p')
\gexec
GRANT SELECT ON ALL SEQUENCES IN SCHEMA public TO backup;

-- run owns both the schema and Liquibase changes. Backups remain read-only.
ALTER DEFAULT PRIVILEGES FOR ROLE run IN SCHEMA public
  GRANT SELECT ON TABLES TO backup;
ALTER DEFAULT PRIVILEGES FOR ROLE run IN SCHEMA public
  GRANT SELECT ON SEQUENCES TO backup;
