# TEMPLATE ONLY. Requires a valid certificate and nginx ports 80/443 published.
# Mount PEM files at /etc/nginx/tls/fullchain.pem and /etc/nginx/tls/privkey.pem.
limit_req_zone $binary_remote_addr zone=per_ip:10m rate=15r/s;
server {
    listen 80;
    server_name api.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    http2 on;
    server_name api.example.com;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    server_tokens off;
    client_max_body_size 1m;
    proxy_connect_timeout 3s;
    proxy_read_timeout 35s;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    # Enable HSTS only after confirming HTTPS works for all intended hosts.
    # add_header Strict-Transport-Security "max-age=31536000" always;
    location = /healthz { access_log off; return 200 "ok\n"; }
    location / {
        limit_req zone=per_ip burst=25 nodelay;
        limit_req_status 429;
        proxy_pass http://gateway:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
    }
}
