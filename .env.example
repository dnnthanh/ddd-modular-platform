# Copy to .env and replace example credentials before starting.
# deploy.sh init creates .env only. Generate JWT keys separately: ./scripts/generate-jwt-keys.sh
# PostgreSQL bootstrap administrator. It is used only by PostgreSQL itself
# and deployment provisioning, never by application or backup services.
DB_PASSWORD=example-change-me-2026
# The app and Liquibase share the schema-owning run account. Backup is read-only.
DB_RUN_PASSWORD=example-change-me-2026
DB_BACKUP_PASSWORD=example-change-me-2026
JWT_ISSUER=ddd-platform-dev
EDGE_BIND=127.0.0.1
EDGE_PORT=8088
OTEL_TRACES_SAMPLER_ARG=1.0

# Dashboard local UI only; tunneled access for remote VPS
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=example-change-me-2026

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=example-change-me-2026
HIKARI_MAX_POOL_SIZE=8
HIKARI_MIN_IDLE=2
EXECUTOR_CORE_SIZE=4
EXECUTOR_MAX_SIZE=16
EXECUTOR_QUEUE_CAPACITY=200

# Optional, bind from app.security.jwt.ttl
JWT_TTL=15m
# Override Gateway rate limit defaults if desired
GATEWAY_RATE_LIMIT_REPLENISH=20
GATEWAY_RATE_LIMIT_BURST=40
GATEWAY_RATE_LIMIT_TOKENS=1

# Grafana Telegram contact point is enabled automatically when both values are nonempty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Safe structured API audit logging (Catalog routes only for bodies)
HTTP_AUDIT_ENABLED=true
HTTP_AUDIT_LOG_BODIES=true
HTTP_AUDIT_MAX_BODY_BYTES=8192
HTTP_AUDIT_MAX_QUERY_CHARS=2048
LOG_LEVEL=INFO
# deploy.sh init fills these with the local user/group IDs.
APP_UID=
APP_GID=

# Local published ports (each application replica gets one port from the range).
LOCAL_BIND=127.0.0.1
APP_REPLICAS=1
GATEWAY_PORT=19080
EUREKA_PORT=8761
APP_PORT_RANGE=28081-28130
# Disabled host access: POSTGRES_PORT=5432
# Disabled host access: REDIS_PORT=6379
# Disabled host access: POSTGRES_EXPORTER_PORT=9187
# Disabled host access: REDIS_EXPORTER_PORT=9121
# Disabled host access: DOCKER_PROXY_PORT=2375
# Disabled host access: ALLOY_PORT=12345
# Disabled host access: OTLP_GRPC_PORT=4317
# Disabled host access: OTLP_HTTP_PORT=4318
# Disabled host access: PROMETHEUS_PORT=9090
# Disabled host access: LOKI_PORT=3100
# Disabled host access: TEMPO_PORT=3200
# Disabled host access: PYROSCOPE_PORT=14040
CATALOG_ITEM_CACHE_TTL=5m

# Local: http://localhost:3000/ ; VPS: set your reachable HTTPS Grafana domain.
GRAFANA_ROOT_URL=http://localhost:3000/
# Hourly PostgreSQL custom-format backups retained for this many days.
BACKUP_RETENTION_DAYS=7

# Monitoring enabled; set COMPOSE_PROFILES empty and OTEL_ENABLED=false for fallback.
OTEL_ENABLED=true
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp

# HTTP localhost only; set true and an explicit HTTPS FE origin on VPS.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

COMPOSE_PROFILES=observability
