# OPTIONAL production example: docker compose -f compose.yaml -f compose.tls.yaml up -d
# 1. Copy this file to compose.tls.yaml (ignored by git if it contains local paths).
# 2. Copy infra/nginx/tls.conf.example to infra/nginx/tls.conf and replace domain.
# 3. Set TLS_CERT_DIR in your environment to a directory containing valid
#    fullchain.pem and privkey.pem, and provision/renew certificates securely.
# 4. Expose only :80/:443 with firewall rules. A baseline firewall/WAF is still required.
services:
  nginx:
    ports:
      - "0.0.0.0:80:80"
      - "0.0.0.0:443:443"
    volumes:
      - ./infra/nginx/tls.conf:/etc/nginx/conf.d/default.conf:ro
      - ${TLS_CERT_DIR:?Set_TLS_CERT_DIR}:/etc/nginx/tls:ro
