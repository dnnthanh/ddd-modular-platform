<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <springProperty scope="context" name="applicationName"
                  source="spring.application.name" defaultValue="modular-app"/>
  <appender name="JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <customFields>{"service_name":"${applicationName}"}</customFields>
      <includeMdc>true</includeMdc>
      <includeKeyValuePairs>true</includeKeyValuePairs>
    </encoder>
  </appender>
  <root level="${LOG_LEVEL:-INFO}">
    <appender-ref ref="JSON_STDOUT"/>
  </root>
</configuration>
